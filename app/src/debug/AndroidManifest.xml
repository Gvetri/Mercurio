<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="org.mercurio.client.ShellHostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|fontScale"
            android:exported="false" />
        <activity
            android:name="org.mercurio.client.ErrorReportingProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="error-reporting"
                    android:scheme="mercurio-journey" />
            </intent-filter>
        </activity>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|fontScale|uiMode" />
    </application>
</manifest>
